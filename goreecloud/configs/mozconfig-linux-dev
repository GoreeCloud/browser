# Development-only Gecko/GTK browser candidate. Not a redistributable build.
# Invoke: MOZCONFIG=goreecloud/configs/mozconfig-linux-dev ./mach configure
# A production GoreeCloud updater and recovery path have NOT been accepted.
ac_add_options --enable-application=browser
ac_add_options --with-branding=browser/branding/goreecloud
ac_add_options --disable-updater
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-goreecloud-gecko
